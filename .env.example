# RaktSetu environment variables
# Copy this file to .env.local and fill in values from your Supabase project.
# These are PUBLIC (anon) keys — safe to expose in the browser, protected by RLS.
# NEVER put the service-role key here or in any file used by client code.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
