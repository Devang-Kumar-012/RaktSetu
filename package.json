{
  "name": "raktsetu",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:init": "tsx scripts/db-init.ts",
    "serve:production": "npm run db:init && next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:async": "tsx scripts/check-async-trycatch.ts",
    "check:driver": "tsx scripts/check-driver.ts",
    "check:bootstrap": "tsx scripts/check-schema-bootstrap.ts",
    "check:rules": "tsx scripts/check-rules.ts",
    "check:rings": "tsx scripts/check-rings.ts",
    "check:invariants": "tsx scripts/check-invariants.ts",
    "check:sqlite": "tsx scripts/check-sqlite.ts",
    "check:migration": "tsx scripts/check-sqlite-migration.ts",
    "check:roles": "tsx scripts/check-roles.ts",
    "check:local": "tsx scripts/check-local-stack.ts",
    "check": "npm run typecheck && npm run check:async && npm run check:rules && npm run check:rings && npm run check:invariants && npm run check:driver && npm run check:bootstrap && npm run check:sqlite && npm run check:migration && npm run check:roles && npm run check:local && npm run build",
    "smoke": "sh scripts/smoke-test.sh",
    "check:live-roles": "tsx scripts/check-live-roles.ts http://localhost:3999",
    "check:browser": "tsx scripts/check-browser-flow.ts http://localhost:3999",
    "check:browser:cleanup": "tsx scripts/check-browser-flow.ts --cleanup",
    "check:responsive": "tsx scripts/check-responsive.ts",
    "check:glass": "tsx scripts/check-glass.ts",
    "check:registration": "tsx scripts/repro-registration.ts",
    "check:persistence": "tsx scripts/check-persistence.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "next": "^15.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
