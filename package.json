{
  "name": "raktsetu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:rules": "tsx scripts/check-rules.ts",
    "check:rings": "tsx scripts/check-rings.ts",
    "check:invariants": "tsx scripts/check-invariants.ts",
    "check:sqlite": "tsx scripts/check-sqlite.ts",
    "check:migration": "tsx scripts/check-sqlite-migration.ts",
    "check:roles": "tsx scripts/check-roles.ts",
    "check:local": "tsx scripts/check-local-stack.ts",
    "check": "npm run check:rules && npm run check:rings && npm run check:invariants && npm run check:sqlite && npm run check:migration && npm run check:roles && npm run check:local && npm run build",
    "smoke": "sh scripts/smoke-test.sh",
    "check:live-roles": "tsx scripts/check-live-roles.ts http://localhost:3999",
    "check:browser": "tsx scripts/check-browser-flow.ts http://localhost:3999",
    "check:browser:cleanup": "tsx scripts/check-browser-flow.ts --cleanup",
    "check:responsive": "tsx scripts/check-responsive.ts"
